      "code": "import { forwardRef, type ComponentType } from \"react\"\nimport { createStore } from \"https://framer.com/m/framer/store.js@^1.0.0\"\nimport { randomColor } from \"https://framer.com/m/framer/utils.js@^0.9.0\"\n\n// Learn more: https://www.framer.com/developers/overrides/\n\nexport function BackToTop(Component): ComponentType {\n    return forwardRef((props, ref) => {\n        const handleClick = (event: MouseEvent) => {\n            // Keep existing onClick behavior if present\n            props?.onClick?.(event)\n\n            // Scroll to top of the current page\n            window.scrollTo({\n                top: 0,\n                left: 0,\n                behavior: \"smooth\",\n            })\n        }\n\n        return <Component ref={ref} {...props} onClick={handleClick} />\n    })\n}\n",
