{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"],
      "@revyme/automation-core": ["./src/index.ts"],
      "@revyme/automation-core/*": ["./src/*"]
    }
  },
  "include": ["src", "test"]
}
