{
  "manifest_version": 3,
  "name": "Framer Native → Revyme · Source Reader",
  "version": "0.2.0",
  "description": "Captures native Framer editor data and normalizes into clean Revyme IR for import.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "downloads", "tabs"],
  "host_permissions": [
    "https://framer.com/*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Capture Framer source" },
  "web_accessible_resources": [{
    "resources": ["page-reader.mjs", "source-adapters.mjs", "capture.mjs"],
    "matches": ["https://framer.com/*"]
  }]
}
