{
  "manifest_version": 3,
  "name": "Framer Native → Revyme · Source Reader",
  "version": "0.1.9",
  "description": "Captures native Framer editor data for import into Revyme.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "downloads"],
  "action": { "default_popup": "popup.html", "default_title": "Захопити source Framer" },
  "web_accessible_resources": [{
    "resources": ["page-reader.mjs", "source-adapters.mjs", "capture.mjs"],
    "matches": ["https://framer.com/*"]
  }]
}
